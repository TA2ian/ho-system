{
  "name": "ho-network-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "tsc -p apps/api/tsconfig.json",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit",
    "test": "tsx --test apps/api/src/domain/*.test.ts apps/api/src/security/*.test.ts apps/api/src/application/*.test.ts apps/api/src/identity/*.test.ts apps/api/src/app-*.test.ts",
    "db:migrate": "tsx apps/api/src/db/migrate.ts",
    "db:migrate:prod": "node apps/api/dist/db/migrate.js",
    "db:verify": "tsx apps/api/src/db/migrate.integration.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
